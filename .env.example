# Launch moment — ISO-8601 with offset. Overrides the default in lib/constants.ts.
NEXT_PUBLIC_LAUNCH_DATE=2026-08-17T12:00:00+05:30

# Public site URL, used for metadata / OG tags.
NEXT_PUBLIC_SITE_URL=https://ambalatharahandlooms.com

# WhatsApp number for the floating chat button, in full international form:
# country code first, DIGITS ONLY — no +, spaces, dashes or brackets.
# India example below. Leave unset and the button simply does not render.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Optional. The message pre-typed into the visitor's chat box.
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello! I would like to know more about your handlooms.

# Optional. Instagram profile URL for the footer icon.
# Leave unset and the icon simply does not render.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/ambalatharahandlooms

# Supabase — the product catalog's database + image storage, and the
# admin panel's real authentication (Supabase Auth). Both values come
# from the Supabase dashboard: Project Settings -> API. The anon/public
# key is safe to ship to the browser by design (Row Level Security in
# supabase/migrations/0001_init.sql is what actually restricts writes to
# a signed-in admin) — but NEVER put the service_role key here or
# anywhere in this app; it must never leave the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Reserved for the e-commerce phase ---
# NEWSLETTER_API_KEY=
