# Postgres connection string (Supabase: Project Settings -> Database -> Connection String).
# Direct connection is used here; switch to the pooled/Supavisor connection string
# if you start seeing "too many connections" errors under load.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Random secret used by NextAuth to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Supabase project URL and service_role key, used server-side only for
# uploading product/banner images to Supabase Storage. Project Settings -> API.
# NEVER prefix these with NEXT_PUBLIC_ or expose them to the browser.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Used only by `npm run db:seed` to create/update the first admin login.
# Set a strong, unique password before seeding a production database.
ADMIN_EMAIL="admin@ambalatharahandlooms.in"
ADMIN_PASSWORD=""
